{
  "name": "prettier-plugin-embed",
  "description": "A configurable Prettier plugin to format embedded languages in JS/TS files.",
  "private": false,
  "version": "0.8.1",
  "type": "module",
  "files": [
    "./dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-embed": {
      "types": "./dist/plugin-embed.d.ts"
    },
    "./embedded/*": {
      "types": "./dist/embedded/*.d.ts"
    },
    "./embedded/index": null,
    "./embedded/register": null,
    "./embedded/types": null,
    "./embedded/utils": null,
    "./embedded/create-embedder": null,
    "./embedded/*/index": null,
    "./embedded/*/language": null,
    "./embedded/*/options": null,
    "./embedded/*/embedder": null,
    "./embedded/*/parser": null,
    "./embedded/*/printer": null
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/prettier-plugin-embed.git"
  },
  "homepage": "https://github.com/Sec-ant/prettier-plugin-embed",
  "bugs": {
    "url": "https://github.com/Sec-ant/prettier-plugin-embed/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "prettier",
    "plugin",
    "prettier-plugin",
    "embed",
    "embedded",
    "embedded-language",
    "format"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "playground:dev": "vite --config playground/vite.config.ts",
    "playground:build": "tsc -p playground/tsconfig.json && vite build --config playground/vite.config.ts",
    "playground:preview": "vite preview --config playground/vite.config.ts",
    "update-hooks": "simple-git-hooks",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit --emitDeclarationOnly false",
    "format": "prettier . --write && biome check --write .",
    "check": "prettier . --check && biome check .",
    "prebuild": "pnpm check && pnpm type-check",
    "build": "vite build",
    "add-glob-import-types": "tsx ./scripts/add-glob-import-types.ts",
    "copy": "copy-files-from-to",
    "postbuild": "tsc --project ./tsconfig.production.json && conc \"pnpm:add-glob-import-types\" \"pnpm:copy\"",
    "test:ci": "vitest --run --pool=threads --coverage",
    "test:compat": "vitest run tests/plugin-compatibility.spec.ts",
    "test:consumer": "pnpm build && node ./scripts/test-consumer.mjs",
    "test:plugins": "pnpm test:ci && pnpm test:consumer && pnpm playground:build && pnpm test:playground",
    "test:playground": "node ./scripts/test-playground.mjs",
    "update:plugins": "node ./scripts/update-plugins.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "process-readme": "tsx ./scripts/process-readme",
    "restore-readme": "tsx ./scripts/restore-readme",
    "prepublishOnly": "pnpm build && pnpm process-readme",
    "postpublish": "pnpm restore-readme",
    "bump-biome:latest": "pnpm add -DE @biomejs/biome@latest",
    "bump-biome:nightly": "pnpm add -DE @biomejs/biome@nightly"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@htnabe/prettier-plugin-go-template": "^0.0.5",
    "@htnabe/prettier-plugin-hugo-post": "^0.0.2",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@poliklot/prettier-plugin-handlebars": "^0.4.1",
    "@prettier/plugin-php": "^0.25.0",
    "@prettier/plugin-pug": "^3.6.0",
    "@prettier/plugin-ruby": "^4.0.4",
    "@prettier/plugin-xml": "^3.4.2",
    "@shopify/prettier-plugin-liquid": "^1.11.2",
    "@stedi/prettier-plugin-jsonata": "^2.1.8",
    "@tombi-toml/wasm-lib": "^1.8.7",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "^5.0.5",
    "codemirror": "^6.0.2",
    "compat-astro-v0": "npm:prettier-plugin-astro@0.14.1",
    "compat-php-v0-24": "npm:@prettier/plugin-php@0.24.0",
    "compat-sh-v0-17": "npm:prettier-plugin-sh@0.17.4",
    "compat-sql-cst-v0-18": "npm:prettier-plugin-sql-cst@0.18.0",
    "compat-sql-cst-v0-22": "npm:prettier-plugin-sql-cst@0.22.1",
    "compat-sql-v0-18": "npm:prettier-plugin-sql@0.18.1",
    "compat-sql-v0-19": "npm:prettier-plugin-sql@0.19.2",
    "compat-svelte-v3": "npm:prettier-plugin-svelte@3.5.2",
    "compat-toml-v2": "npm:prettier-plugin-toml@2.0.6",
    "compat-toml-v3": "npm:prettier-plugin-toml@3.0.2",
    "compat-xml-v2": "npm:@prettier/plugin-xml@2.2.0",
    "concurrently": "^10.0.6",
    "copy-files-from-to": "^4.0.1",
    "lint-staged": "^17.6.0",
    "lz-string": "^1.5.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-gherkin": "^4.0.0",
    "prettier-plugin-glsl": "^0.3.1",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-java": "^2.11.0",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-jte": "^1.5.0",
    "prettier-plugin-latex": "^2.0.1",
    "prettier-plugin-marko": "^4.1.3",
    "prettier-plugin-motoko": "^0.13.0",
    "prettier-plugin-mustache": "^0.2.2",
    "prettier-plugin-nginx": "^2.0.0",
    "prettier-plugin-nunjucks": "^0.2.3",
    "prettier-plugin-pegjs": "^2.0.2",
    "prettier-plugin-powershell": "^2.2.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-solidity": "^2.4.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-sql-cst": "^0.23.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-toml": "^4.0.0",
    "prettier-plugin-xquery": "^1.7.0",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/estree": "^1.0.9",
    "tiny-jsonc": "^1.0.2"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
