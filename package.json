{
  "name": "prettier-plugin-embed",
  "description": "A configurable Prettier plugin to format embedded languages in JS/TS files.",
  "private": false,
  "version": "0.6.0",
  "type": "module",
  "files": [
    "./dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-embed": {
      "types": "./dist/plugin-embed.d.ts"
    },
    "./embedded/*": {
      "types": "./dist/embedded/*.d.ts"
    },
    "./embedded/index": null,
    "./embedded/register": null,
    "./embedded/types": null,
    "./embedded/utils": null,
    "./embedded/*/index": null,
    "./embedded/*/language": null,
    "./embedded/*/options": null,
    "./embedded/*/embedder": null,
    "./embedded/*/parser": null,
    "./embedded/*/printer": null
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sec-ant/prettier-plugin-embed.git"
  },
  "homepage": "https://github.com/Sec-ant/prettier-plugin-embed",
  "bugs": {
    "url": "https://github.com/Sec-ant/prettier-plugin-embed/issues",
    "email": "zezhengwu@proton.me"
  },
  "keywords": [
    "prettier",
    "plugin",
    "prettier-plugin",
    "embed",
    "embedded",
    "embedded-language",
    "format"
  ],
  "author": {
    "name": "Ze-Zheng Wu"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "update-hooks": "simple-git-hooks",
    "lint": "biome lint .",
    "type-check": "tsc --noEmit --emitDeclarationOnly false",
    "format": "prettier . --write && biome check --write .",
    "check": "prettier . --check && biome check .",
    "prebuild": "pnpm -s check && pnpm -s type-check",
    "build": "vite build",
    "add-glob-import-types": "tsx ./scripts/add-glob-import-types.ts",
    "copy": "copy-files-from-to",
    "postbuild": "tsc --project ./tsconfig.production.json && conc \"pnpm:add-glob-import-types\" \"pnpm:copy\"",
    "test:ci": "vitest --run --pool=threads --coverage",
    "test:consumer": "pnpm -s build && node ./scripts/test-consumer.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "process-readme": "tsx ./scripts/process-readme",
    "restore-readme": "tsx ./scripts/restore-readme",
    "prepublishOnly": "pnpm -s build && pnpm -s process-readme",
    "postpublish": "pnpm -s restore-readme",
    "bump-biome:latest": "pnpm add -DE @biomejs/biome@latest",
    "bump-biome:nightly": "pnpm add -DE @biomejs/biome@nightly"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@prettier/plugin-php": "^0.25.0",
    "@prettier/plugin-pug": "^3.6.0",
    "@prettier/plugin-ruby": "^4.0.4",
    "@prettier/plugin-xml": "^3.4.2",
    "@stedi/prettier-plugin-jsonata": "^2.1.8",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^10.0.6",
    "copy-files-from-to": "^4.0.1",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-glsl": "^0.3.1",
    "prettier-plugin-ini": "^1.3.0",
    "prettier-plugin-java": "^2.11.0",
    "prettier-plugin-latex": "^2.0.1",
    "prettier-plugin-nginx": "^2.0.0",
    "prettier-plugin-pegjs": "^2.0.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-properties": "^0.3.1",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-sql-cst": "^0.23.0",
    "prettier-plugin-toml": "^3.0.2",
    "simple-git-hooks": "^2.14.0",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@types/estree": "^1.0.9",
    "dedent": "^1.7.2",
    "tiny-jsonc": "^1.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
